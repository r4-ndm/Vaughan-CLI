# Rust build artifacts
/target
**/*.rs.bk

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Local configuration / secrets
.env
.env.local
*.local.json
vaughan-backup-*.json
*backup*

# Live wallet data (normally under ~/.local/share/vaughan-cli/) — never commit
# a copy that lands in the repo.
wallet.json
wallet.json.*
agent.key.json
assist-unlock.json
site-grants.json
*.session
vb.target
vault-safety-*/
vb-profiles/

# Private strategy / planning (local only — never commit)
/private/

# AA fixture capture workspace (throwaway forge project; only the resulting
# fixture JSON in vaughan-aa/tests/fixtures/ is committed)
.fixtures-capture/

# Logs
*.log

# Python byte-code from helper scripts
__pycache__/

# Temporary files
*.tmp
*.temp
temp-*/

# Local wallet data (never commit keys)
*.keystore
wallet.json
*.bak

# Node dependencies
node_modules/

# Local-only hardware smoke helpers (repo is Rust-only)
scripts/trezor_send_tx.py
