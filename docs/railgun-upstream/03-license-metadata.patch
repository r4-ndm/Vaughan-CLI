+license.workspace = true
 
 [dependencies]
 alloy = { workspace = true }
diff --git a/crates/public-broadcaster-protocol/Cargo.toml b/crates/public-broadcaster-protocol/Cargo.toml
index 4aab390..8ceb662 100644
--- a/crates/public-broadcaster-protocol/Cargo.toml
+++ b/crates/public-broadcaster-protocol/Cargo.toml
@@ -3,6 +3,7 @@ name = "public-broadcaster-protocol"
 version = "0.1.0"
 edition.workspace = true
 rust-version.workspace = true
+license.workspace = true
 
 [dependencies]
 alloy = { workspace = true }
diff --git a/crates/railgun-wallet/Cargo.toml b/crates/railgun-wallet/Cargo.toml
index fc3e875..f181b61 100644
--- a/crates/railgun-wallet/Cargo.toml
