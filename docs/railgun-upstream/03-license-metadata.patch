diff --git a/crates/trustless-artifacts/Cargo.toml b/crates/trustless-artifacts/Cargo.toml
index 803f3bb..067b3ea 100644
--- a/crates/trustless-artifacts/Cargo.toml
+++ b/crates/trustless-artifacts/Cargo.toml
@@ -3,6 +3,7 @@ name = "trustless-artifacts"
 version = "0.1.0"
