{
  "mcpServers": {
    "vaughan": {
      "command": "cargo",
      "args": [
        "run",
        "-q",
        "-p",
        "vaughan-cli",
        "--",
        "mcp",
        "--profile",
        "default"
      ],
      "env": {
        "VAUGHAN_DAPP_BROWSER_CHROME": "/usr/bin/chromium",
        "VAUGHAN_DAPP_BROWSER_CDP_PORT": "9222",
        "DISPLAY": ":0"
      }
    },
    "vaughan-sentient": {
      "command": "cargo",
      "args": [
        "run",
        "-q",
        "-p",
        "vaughan-cli",
        "--",
        "mcp",
        "--profile",
        "sentient"
      ],
      "env": {
        "VAUGHAN_DAPP_BROWSER_CHROME": "/usr/bin/chromium",
        "VAUGHAN_DAPP_BROWSER_CDP_PORT": "9222",
        "DISPLAY": ":0"
      }
    }
  }
}
