{
  "mcpServers": {
    "vaughan": {
      "command": "cargo",
      "args": [
        "run",
        "-q",
        "-p",
        "vaughan-cli",
        "--",
        "mcp",
        "--profile",
        "default"
      ]
    },
    "vaughan-sentient": {
      "command": "cargo",
      "args": [
        "run",
        "-q",
        "-p",
        "vaughan-cli",
        "--",
        "mcp",
        "--profile",
        "sentient"
      ]
    }
  }
}
