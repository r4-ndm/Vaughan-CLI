[Unit]
Description=Vaughan Isolated Signer Daemon (vaughan signerd)
Documentation=https://github.com/r4-ndm/Vaughan-CLI
After=network.target

[Service]
Type=simple
User=vaughan-signer
Group=vaughan-signer
EnvironmentFile=-/etc/vaughan/sentient.env
ExecStart=/usr/local/bin/vaughan signerd --store /var/lib/vaughan/sentient --socket /run/vaughan/signerd.sock --allow-uid @OWNER_UID@ --password-env VAUGHAN_WALLET_PASSWORD
RuntimeDirectory=vaughan
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3

# Hardening directives (S3 spec)
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
ReadWritePaths=/var/lib/vaughan

[Install]
WantedBy=multi-user.target
