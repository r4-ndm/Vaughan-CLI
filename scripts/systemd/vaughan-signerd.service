[Unit]
Description=Vaughan Isolated Signer Daemon (vaughan signerd)
Documentation=https://github.com/r4-ndm/Vaughan-CLI
After=network.target
# A daemon panic or OOM exits the (panic = "abort") process and Restart=on-failure brings it
# back in RestartSec — with the in-memory circuit breaker un-tripped unless signerd-tripped.json
# survived the restart (see Signer::new / run_signerd). These two bound a crash LOOP so it stops
# instead of spinning: at most 5 restarts in any 60s window, then systemd leaves the unit failed.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=vaughan-signer
Group=vaughan-signer
EnvironmentFile=-/etc/vaughan/sentient.env
ExecStart=/usr/local/bin/vaughan signerd --store /var/lib/vaughan/sentient --socket /run/vaughan/signerd.sock --allow-uid @OWNER_UID@ --password-env VAUGHAN_WALLET_PASSWORD
RuntimeDirectory=vaughan
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3

# Hardening directives (S3 spec)
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
ReadWritePaths=/var/lib/vaughan

# Durable kill switch: `{"op":"trip"}` (and every automatic trip) writes
# /var/lib/vaughan/sentient/signerd-tripped.json before returning ok, and `signerd` loads it
# BEFORE binding the socket — so a crash/OOM/restart comes back tripped, not clean. There is
# no untrip op over the socket. To clear a trip: root removes that file, then restarts the
# unit (`systemctl restart vaughan-signerd`). See docs/sentient-ops.md.

[Install]
WantedBy=multi-user.target
